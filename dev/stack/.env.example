# Lokale Entwicklungswerte. Diese Datei darf versioniert werden.
# Für persönliche Overrides: nach .env kopieren. .env bleibt in Git ignoriert.

DATENPORTAL_BUCKET=ch.so.datenportal
AWS_DEFAULT_REGION=garage
AWS_ACCESS_KEY_ID=GK0123456789abcdef0123456789abcdef
AWS_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Ports auf dem Host
GARAGE_S3_PORT=3900
GARAGE_RPC_PORT=3901
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903
DATENPORTAL_DOWNLOAD_PORT=8081

# Bequeme Host-URLs für App/Jenkins/GRETL ausserhalb von Docker
LOCAL_AWS_ENDPOINT_URL=http://localhost:3900
LOCAL_DOWNLOAD_BASE_URL=http://localhost:8081
